{
  "name": "app-ai",
  "version": "1.0.0",
  "description": "LimeSpot App AI service - the provider-neutral inference worker on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shim": "node scripts/dev-claude-shim.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "tail": "wrangler tail",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:caching": "node scripts/verify-caching.mjs",
    "verify:openai": "node scripts/verify-openai.mjs",
    "verify:moonshot": "node scripts/verify-moonshot.mjs",
    "verify:kimi": "node scripts/verify-kimi.mjs",
    "verify:gemini": "node scripts/verify-gemini.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "update-deps": "npm update && npm audit fix"
  },
  "keywords": [
    "proxy",
    "claude",
    "anthropic",
    "ai",
    "cloudflare",
    "workers"
  ],
  "author": "LimeSpot",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2",
    "zod": "^4.4.3"
  }
}
