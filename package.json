{
  "name": "app-ai",
  "version": "1.0.0",
  "description": "App AI service for LimeSpot - Claude API integration for Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shim": "node scripts/dev-claude-shim.mjs",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:caching": "node scripts/verify-caching.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "update-deps": "npm update && npm audit fix"
  },
  "keywords": [
    "proxy",
    "claude",
    "anthropic",
    "ai",
    "cloudflare",
    "workers"
  ],
  "author": "LimeSpot",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.15",
    "zod": "^4.4.3"
  }
}
