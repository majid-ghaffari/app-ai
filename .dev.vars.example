# Local development configuration for `wrangler dev` (npm run dev).
#
# Copy this file to `.dev.vars` (gitignored) and fill in the secrets. Values
# here OVERRIDE the production `[vars]` in wrangler.toml for the local worker.
# Every variable is REQUIRED unless marked otherwise — src/config.ts throws on
# a missing one (no fallback defaults). See docs/CODE-PATTERNS.md →
# "No Hardcoded Config Values".

# Deployment label. Logging behavior is controlled only by the LOG_TARGETS_* variables below.
ENVIRONMENT=local

# OPTIONAL dev-launcher output path. `npm run dev` mirrors Wrangler output here so another process
# can inspect the active inference trace. Defaults to app-ai-dev.log (already covered by *.log in
# .gitignore).
# APP_AI_DEV_LOG_FILE=app-ai-dev.log

# Each level fans out to a comma-separated target list (`console`, `seq`) or `ignore`.
# Local development intentionally mirrors every level to the terminal and private Seq.
LOG_TARGETS_TRACE=console,seq
LOG_TARGETS_DEBUG=console,seq
LOG_TARGETS_INFO=console,seq
LOG_TARGETS_WARN=console,seq
LOG_TARGETS_ERROR=console,seq
LOG_TARGETS_FATAL=console,seq
LOG_SEQ_INGEST_URL=https://log.limespot.net/ingest/clef
# OPTIONAL secret. The shared endpoint currently accepts anonymous CLEF ingestion.
# LOG_SEQ_API_KEY=

# Personalizer API base URL, no trailing slash. Miniflare/workerd fetch can't
# accept nginx's self-signed cert on https://local.personalizer.io, so the
# LOCAL worker talks to Personalizer over plain HTTP (same Personalizer process;
# nginx just fronts it with TLS for the browser).
PERSONALIZER_API_URL=http://127.0.0.1:5000

# SECRET — caller-auth token toward Personalizer's integration bridge (the
# platform toolsets send it as X-Personalizer-Integration-Bridge-Token;
# src/toolsets/integration-bridge.ts). Must match a token in the local
# Personalizer's IntegrationBridge caller map.
PERSONALIZER_INTEGRATION_BRIDGE_TOKEN=local-dev-integration-bridge-token

# ── AI channel ───────────────────────────────────────────────────────────────
# Anthropic API origin, no trailing slash.
#
# DEV DEFAULT = the FREE local Claude-Code shim (scripts/dev-claude-shim.mjs).
# Start it with `npm run dev:shim`, then plain `wrangler dev` fulfils every
# worker inference via Claude Code (the machine's Claude Code auth) — NO
# Anthropic credits are ever spent. This is the standard, permanent local
# channel; leave it as-is.
#
# The worker talks to Anthropic through exactly one seam (src/lib/anthropic.ts,
# `${ANTHROPIC_API_BASE}/v1/...`), so this ONE line is the whole toggle — no
# src change, no code branch.
ANTHROPIC_API_BASE=http://127.0.0.1:8788

# To use the REAL, PAID Anthropic API from local dev (rarely needed — prod-only
# by policy), you must do TWO things, both deliberate:
#   1. Point the base back at the real API:  ANTHROPIC_API_BASE=https://api.anthropic.com
#   2. Opt in explicitly:                     AI_CHANNEL=prod
# The cred-burn guard (test/dev-shim.test.ts → assertDevAiChannel) FAILS a
# dev/test run that points at api.anthropic.com without AI_CHANNEL=prod, so a
# credit-spending config can never slip in silently.
# AI_CHANNEL=prod

# Origins allowed to send credentialed CORS requests (comma-separated).
CREDENTIALED_ORIGINS=https://local-app.limespot.com,http://localhost:4200,http://localhost:3000

# Capability tiers (provider-agnostic) bound to concrete models — the prompt
# registry (src/prompt-registry.ts) tags each prompt with a tier; resolveModel maps it
# here. Swap a value to bump a model version or switch provider.
MODEL_FAST=claude-haiku-4-5
MODEL_BALANCED=claude-sonnet-5
MODEL_FRONTIER=claude-opus-4-8

# SECRET — your Anthropic API key. Never commit the real value.
CLAUDE_API_KEY=sk-ant-your-key-here

# OPTIONAL — Brain-defaults source URL override (src/lib/brain-defaults.ts).
# When UNSET (the default), the PROPOSE prompts fetch the tenant's canonical Brain
# default RecommendationsSettings from the authenticated endpoint
# ${PERSONALIZER_API_URL}/v1/personalizerConfig?defaultRecommendationsSettings=true
# (forwarding the merchant context-ID). Set it to point the provider at a
# versioned/immutable CDN object instead (fetched as-is, without the context-ID).
# Its absence changes behavior explicitly (documented), so it carries no fallback.
# RECOMMENDATIONS_DEFAULTS_URL=https://edge.personalizer.io/defaults/recommendations/v1.json
