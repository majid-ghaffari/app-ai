# Local development configuration for `wrangler dev` (npm run dev).
#
# Copy this file to `.dev.vars` (gitignored) and fill in the secrets. Values
# here OVERRIDE the production `[vars]` in wrangler.toml for the local worker.
# Every variable is REQUIRED unless marked otherwise — src/config.ts throws on
# a missing one (no fallback defaults). See docs/CODE-PATTERNS.md →
# "No Hardcoded Config Values".

# Deployment metadata (dashboard/tail context only; code never branches on it).
ENVIRONMENT=local

# Personalizer API base URL, no trailing slash. Miniflare/workerd fetch can't
# accept nginx's self-signed cert on https://local.personalizer.io, so the
# LOCAL worker talks to Personalizer over plain HTTP (same Personalizer process;
# nginx just fronts it with TLS for the browser).
PERSONALIZER_API_URL=http://127.0.0.1:5000

# SECRET — caller-auth token toward Personalizer's integration bridge (the
# platform toolsets send it as X-Personalizer-Integration-Bridge-Token;
# src/toolsets/integration-bridge.ts). Must match a token in the local
# Personalizer's IntegrationBridge caller map.
PERSONALIZER_INTEGRATION_BRIDGE_TOKEN=local-dev-integration-bridge-token

# ── AI channel ───────────────────────────────────────────────
# Anthropic API origin, no trailing slash.
#
# DEV DEFAULT = the FREE local Claude-Code shim (scripts/dev-claude-shim.mjs).
# Start it with `npm run dev:shim`, then `npm run dev` fulfills every Worker
# inference through the machine's Claude Code authentication without spending
# Anthropic API credits.
ANTHROPIC_API_BASE=http://127.0.0.1:8788

# Using the real paid API locally requires both deliberate settings:
#   ANTHROPIC_API_BASE=https://api.anthropic.com
#   AI_CHANNEL=prod
# The dev-shim guard rejects api.anthropic.com without that explicit opt-in.
# AI_CHANNEL=prod

# Origins allowed to send credentialed CORS requests (comma-separated).
CREDENTIALED_ORIGINS=https://local-app.limespot.com,http://localhost:4200,http://localhost:3000

# Deploy-time model choices for the prompt registry (src/prompts.ts).
MODEL_DEFAULT=claude-opus-4-8
MODEL_PLACEMENT=claude-haiku-4-5

# SECRET — your Anthropic API key. Never commit the real value.
CLAUDE_API_KEY=sk-ant-your-key-here
